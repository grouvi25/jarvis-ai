# J.A.R.V.I.S. — Переменные окружения
# Скопируй в .env и заполни нужные значения:
#   cp .env.example .env

# LLM (API-ключ провайдера, если не через OmniRoute)
# JARVIS_LLM_API_KEY=sk-...
# JARVIS_LLM_PROVIDER=openai
# JARVIS_LLM_MODEL=gpt-4o-mini
# JARVIS_LLM_BASE_URL=https://api.openai.com/v1

# Telegram бот
# JARVIS_TELEGRAM_TOKEN=123456:ABC...

# WiFi (для авто-переподключения в общаге)
# JARVIS_WIFI_SSID=Dormitory_WiFi
# JARVIS_WIFI_PASSWORD=password123
