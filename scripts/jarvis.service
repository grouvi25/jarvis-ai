[Unit]
Description=J.A.R.V.I.S. — персональный AI-ассистент
After=network.target sound.target

[Service]
Type=simple
ExecStart=%h/.local/bin/jarvis --text
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=PULSE_SERVER=unix:/run/user/%U/pulse/native

[Install]
WantedBy=default.target
